---
import { getSP500Quote } from '../lib/stock';

const initialQuote = await getSP500Quote();
const isPositive = initialQuote.change >= 0;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<title>Hello World — S&P 500 Tracker with Live Graph</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="background-glow"></div>

		<main class="container">
			<header class="hero">
				<div class="badge">
					<span class="badge-dot"></span>
					Astro Hello World Demo
				</div>
				<h1 class="title">
					Hello, <span class="gradient-text">World!</span>
				</h1>
				<p class="subtitle">
					A high-performance Astro website featuring real-time market data and a <strong>live streaming graph</strong> for the S&P 500 Index.
				</p>
			</header>

			<!-- Stock Display Card -->
			<section class="card" id="quote-card">
				<div class="card-header">
					<div class="symbol-info">
						<span class="ticker" id="stock-symbol">{initialQuote.symbol}</span>
						<h2 class="company-name" id="stock-name">{initialQuote.name}</h2>
					</div>
					<div class="status-indicator">
						<span class="live-dot" id="live-dot"></span>
						<span class="status-text" id="status-text">
							{initialQuote.status === 'live' ? 'Live Feed' : 'Cached Data'}
						</span>
					</div>
				</div>

				<div class="price-section">
					<div class="price-row">
						<span class="price-value" id="price-value">
							{initialQuote.price.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
						</span>
						<span class="currency" id="currency-text">{initialQuote.currency}</span>
					</div>
					<div
						class={`change-badge ${isPositive ? 'positive' : 'negative'}`}
						id="change-badge"
					>
						<span class="change-icon" id="change-icon">{isPositive ? '▲' : '▼'}</span>
						<span id="change-amount">
							{isPositive ? '+' : ''}{initialQuote.change.toFixed(2)}
						</span>
						<span id="change-percent">
							({isPositive ? '+' : ''}{initialQuote.changePercent.toFixed(2)}%)
						</span>
					</div>
				</div>

				<!-- Live Interactive Graph -->
				<div class="chart-wrapper">
					<div class="chart-header">
						<div class="chart-title-group">
							<span class="chart-title">Intraday Live Performance</span>
							<span class="stream-pill" id="stream-indicator">
								<span class="stream-dot"></span>
								STREAMING
							</span>
						</div>
						<div class="chart-controls">
							<button id="sim-toggle-btn" class="chart-btn" type="button" title="Toggle simulated live ticks">
								<span class="sim-icon">⚡</span>
								<span id="sim-btn-text">Simulate Ticks: OFF</span>
							</button>
						</div>
					</div>

					<div class="chart-container" id="chart-container">
						<svg id="stock-chart" viewBox="0 0 600 220" preserveAspectRatio="none">
							<defs>
								<linearGradient id="chartGradient" x1="0" y1="0" x2="0" y2="1">
									<stop offset="0%" stop-color="#8b5cf6" stop-opacity="0.45" />
									<stop offset="70%" stop-color="#3b82f6" stop-opacity="0.1" />
									<stop offset="100%" stop-color="#3b82f6" stop-opacity="0.0" />
								</linearGradient>
								<filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
									<feGaussianBlur stdDeviation="3" result="blur" />
									<feComposite in="SourceGraphic" in2="blur" operator="over" />
								</filter>
							</defs>

							<!-- Horizontal Grid Lines -->
							<line class="grid-line" x1="0" y1="35" x2="600" y2="35" />
							<line class="grid-line" x1="0" y1="105" x2="600" y2="105" />
							<line class="grid-line" x1="0" y1="175" x2="600" y2="175" />

							<!-- Price Labels Inside SVG -->
							<text class="axis-label" id="axis-max" x="12" y="30">--</text>
							<text class="axis-label" id="axis-mid" x="12" y="100">--</text>
							<text class="axis-label" id="axis-min" x="12" y="170">--</text>

							<!-- Area & Line Paths -->
							<path id="chart-area" class="chart-area" d="" fill="url(#chartGradient)"></path>
							<path id="chart-line" class="chart-line" d="" filter="url(#glow)"></path>

							<!-- Pulse Marker for Latest Data Point -->
							<circle id="pulse-outer" class="pulse-ring" cx="0" cy="0" r="8"></circle>
							<circle id="pulse-point" class="pulse-core" cx="0" cy="0" r="4.5"></circle>

							<!-- Crosshair Guide -->
							<line id="crosshair-x" class="crosshair-line" x1="0" y1="20" x2="0" y2="190" visibility="hidden"></line>
							<circle id="crosshair-dot" class="crosshair-dot" cx="0" cy="0" r="5" visibility="hidden"></circle>
						</svg>

						<!-- Floating Interactive Tooltip -->
						<div id="chart-tooltip" class="chart-tooltip" style="display: none;">
							<div class="tooltip-price" id="tooltip-price">--</div>
							<div class="tooltip-time" id="tooltip-time">--</div>
						</div>
					</div>

					<div class="chart-time-row">
						<span id="chart-start-time">--</span>
						<span id="chart-point-count" class="point-count-badge">Loading points...</span>
						<span id="chart-end-time">--</span>
					</div>

					<!-- Live incoming data tick bar -->
					<div class="live-ticker-bar">
						<span class="live-ticker-label">Incoming Tick Feed:</span>
						<span class="live-ticker-val" id="live-ticker-text">Waiting for first stream event...</span>
					</div>
				</div>

				<div class="metrics-grid">
					<div class="metric-item">
						<span class="metric-label">Previous Close</span>
						<span class="metric-val" id="val-prev-close">
							{initialQuote.previousClose.toLocaleString('en-US', { minimumFractionDigits: 2 })}
						</span>
					</div>
					<div class="metric-item">
						<span class="metric-label">Day Range</span>
						<span class="metric-val" id="val-day-range">
							{initialQuote.dayLow.toLocaleString('en-US', { minimumFractionDigits: 2 })} - {initialQuote.dayHigh.toLocaleString('en-US', { minimumFractionDigits: 2 })}
						</span>
					</div>
					<div class="metric-item">
						<span class="metric-label">52-Week Range</span>
						<span class="metric-val" id="val-52w-range">
							{initialQuote.fiftyTwoWeekLow.toLocaleString('en-US', { minimumFractionDigits: 2 })} - {initialQuote.fiftyTwoWeekHigh.toLocaleString('en-US', { minimumFractionDigits: 2 })}
						</span>
					</div>
					<div class="metric-item">
						<span class="metric-label">Market Time</span>
						<span class="metric-val" id="val-market-time">{initialQuote.formattedTime}</span>
					</div>
				</div>

				<div class="card-footer">
					<div class="last-updated">
						<span>Last Updated: </span>
						<strong id="last-updated-time">Just now</strong>
					</div>
					<div class="actions">
						<button id="refresh-btn" class="refresh-button" type="button" aria-label="Refresh stock quote">
							<svg class="refresh-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8" />
								<path d="M21 3v5h-5" />
								<path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16" />
								<path d="M8 16H3v5" />
							</svg>
							<span>Refresh Quote</span>
						</button>
					</div>
				</div>
			</section>

			<!-- Astro Features / Info Section -->
			<section class="features">
				<div class="feature-card">
					<div class="feature-icon">📈</div>
					<h3>Live SVG Streaming</h3>
					<p>Pure modern SVG graph rendering with zero heavy chart dependencies, hardware accelerated.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">⚡</div>
					<h3>Dynamic Ingestion</h3>
					<p>Automatically records and plots incoming market ticks as they arrive without reloading.</p>
				</div>
				<div class="feature-card">
					<div class="feature-icon">🚀</div>
					<h3>Server Pre-rendered</h3>
					<p>Initial state renders instantaneously on the server and hydrates into a reactive client chart.</p>
				</div>
			</section>

			<footer class="footer">
				<p>Powered by <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> • S&P 500 Live Tracker</p>
			</footer>
		</main>

		<!-- Pass server-rendered initial quote & history to client script -->
		<script id="initial-data" type="application/json" set:html={JSON.stringify(initialQuote)}></script>

		<!-- Client-Side Live Graph & Interactivity -->
		<script>
			interface ChartPoint {
				timestamp: number;
				time: string;
				price: number;
			}

			interface StockData {
				symbol: string;
				name: string;
				price: number;
				change: number;
				changePercent: number;
				previousClose: number;
				dayHigh: number;
				dayLow: number;
				fiftyTwoWeekHigh: number;
				fiftyTwoWeekLow: number;
				currency: string;
				timestamp: number;
				formattedTime: string;
				isPositive: boolean;
				status: 'live' | 'fallback';
				history?: ChartPoint[];
			}

			// Parse initial data
			const rawDataEl = document.getElementById('initial-data');
			let initialData: StockData | null = null;
			try {
				if (rawDataEl?.textContent) {
					initialData = JSON.parse(rawDataEl.textContent);
				}
			} catch (e) {
				console.error('Failed to parse initial data', e);
			}

			// Elements
			const refreshBtn = document.getElementById('refresh-btn');
			const priceValue = document.getElementById('price-value');
			const changeBadge = document.getElementById('change-badge');
			const changeIcon = document.getElementById('change-icon');
			const changeAmount = document.getElementById('change-amount');
			const changePercent = document.getElementById('change-percent');
			const valPrevClose = document.getElementById('val-prev-close');
			const valDayRange = document.getElementById('val-day-range');
			const val52wRange = document.getElementById('val-52w-range');
			const valMarketTime = document.getElementById('val-market-time');
			const lastUpdatedTime = document.getElementById('last-updated-time');
			const statusText = document.getElementById('status-text');

			// Chart Elements
			const chartContainer = document.getElementById('chart-container');
			const chartSvg = document.getElementById('stock-chart');
			const chartLine = document.getElementById('chart-line') as unknown as SVGPathElement | null;
			const chartArea = document.getElementById('chart-area') as unknown as SVGPathElement | null;
			const pulseOuter = document.getElementById('pulse-outer') as unknown as SVGCircleElement | null;
			const pulsePoint = document.getElementById('pulse-point') as unknown as SVGCircleElement | null;
			const axisMax = document.getElementById('axis-max');
			const axisMid = document.getElementById('axis-mid');
			const axisMin = document.getElementById('axis-min');
			const chartStartTime = document.getElementById('chart-start-time');
			const chartEndTime = document.getElementById('chart-end-time');
			const chartPointCount = document.getElementById('chart-point-count');
			const crosshairX = document.getElementById('crosshair-x') as unknown as SVGLineElement | null;
			const crosshairDot = document.getElementById('crosshair-dot') as unknown as SVGCircleElement | null;
			const tooltip = document.getElementById('chart-tooltip');
			const tooltipPrice = document.getElementById('tooltip-price');
			const tooltipTime = document.getElementById('tooltip-time');
			const liveTickerText = document.getElementById('live-ticker-text');
			const streamIndicator = document.getElementById('stream-indicator');
			const simToggleBtn = document.getElementById('sim-toggle-btn');
			const simBtnText = document.getElementById('sim-btn-text');

			// Chart state
			let chartData: ChartPoint[] = initialData?.history || [];
			let currentPrice = initialData?.price || 7600;
			let previousClose = initialData?.previousClose || 7550;
			let calculatedPoints: Array<{ x: number; y: number; data: ChartPoint }> = [];
			let simulateTicks = false;
			let simIntervalId: any = null;
			let totalTicksReceived = chartData.length;

			// Flash ticker text on incoming tick
			function logTick(price: number, timeStr: string, source = 'Live Feed') {
				totalTicksReceived++;
				if (liveTickerText) {
					liveTickerText.innerHTML = `<strong>${source}:</strong> $${price.toFixed(2)} at ${timeStr} • Total ticks: ${totalTicksReceived}`;
					liveTickerText.classList.remove('tick-flash');
					void liveTickerText.offsetWidth;
					liveTickerText.classList.add('tick-flash');
				}
				if (streamIndicator) {
					streamIndicator.classList.remove('active');
					void streamIndicator.offsetWidth;
					streamIndicator.classList.add('active');
				}
			}

			// Render the SVG graph
			function renderChart() {
				if (!chartSvg || chartData.length < 2) return;

				const svgW = 600;
				const svgH = 220;
				const padTop = 24;
				const padBottom = 34;
				const padLeft = 14;
				const padRight = 14;

				const innerW = svgW - padLeft - padRight;
				const innerH = svgH - padTop - padBottom;

				const prices = chartData.map((d) => d.price);
				let minP = Math.min(...prices);
				let maxP = Math.max(...prices);

				if (minP === maxP) {
					minP -= 2;
					maxP += 2;
				}

				// 6% vertical padding inside bounds
				const range = maxP - minP;
				const chartMin = minP - range * 0.06;
				const chartMax = maxP + range * 0.06;
				const chartRange = chartMax - chartMin;

				calculatedPoints = chartData.map((pt, idx) => {
					const x = padLeft + (idx / (chartData.length - 1)) * innerW;
					const y = padTop + (1 - (pt.price - chartMin) / chartRange) * innerH;
					return { x, y, data: pt };
				});

				// Build SVG Path
				let pathStr = `M ${calculatedPoints[0].x.toFixed(1)} ${calculatedPoints[0].y.toFixed(1)}`;
				for (let i = 1; i < calculatedPoints.length; i++) {
					pathStr += ` L ${calculatedPoints[i].x.toFixed(1)} ${calculatedPoints[i].y.toFixed(1)}`;
				}

				const lastPt = calculatedPoints[calculatedPoints.length - 1];
				const firstPt = calculatedPoints[0];
				const areaStr = `${pathStr} L ${lastPt.x.toFixed(1)} ${svgH - padBottom} L ${firstPt.x.toFixed(1)} ${svgH - padBottom} Z`;

				if (chartLine) chartLine.setAttribute('d', pathStr);
				if (chartArea) chartArea.setAttribute('d', areaStr);

				// Move pulse marker to the latest point
				if (pulseOuter) {
					pulseOuter.setAttribute('cx', lastPt.x.toFixed(1));
					pulseOuter.setAttribute('cy', lastPt.y.toFixed(1));
				}
				if (pulsePoint) {
					pulsePoint.setAttribute('cx', lastPt.x.toFixed(1));
					pulsePoint.setAttribute('cy', lastPt.y.toFixed(1));
				}

				// Update Axis Labels
				if (axisMax) axisMax.textContent = `$${maxP.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
				if (axisMid) axisMid.textContent = `$${((maxP + minP) / 2).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
				if (axisMin) axisMin.textContent = `$${minP.toLocaleString('en-US', { minimumFractionDigits: 2 })}`;

				if (chartStartTime) chartStartTime.textContent = chartData[0].time;
				if (chartEndTime) chartEndTime.textContent = chartData[chartData.length - 1].time;
				if (chartPointCount) chartPointCount.textContent = `${chartData.length} data points recorded`;

				// Color theme based on gain or loss
				const isGain = chartData[chartData.length - 1].price >= chartData[0].price;
				chartSvg.classList.toggle('chart-gain', isGain);
				chartSvg.classList.toggle('chart-loss', !isGain);
			}

			// Update values in DOM
			function updateDOMWithData(data: StockData) {
				currentPrice = data.price;
				previousClose = data.previousClose;

				if (priceValue) {
					priceValue.textContent = Number(data.price).toLocaleString('en-US', {
						minimumFractionDigits: 2,
						maximumFractionDigits: 2
					});
					priceValue.classList.remove('pulse');
					void priceValue.offsetWidth;
					priceValue.classList.add('pulse');
				}

				const isPos = data.change >= 0;
				if (changeBadge) {
					changeBadge.className = `change-badge ${isPos ? 'positive' : 'negative'}`;
				}
				if (changeIcon) changeIcon.textContent = isPos ? '▲' : '▼';
				if (changeAmount) {
					changeAmount.textContent = `${isPos ? '+' : ''}${data.change.toFixed(2)}`;
				}
				if (changePercent) {
					changePercent.textContent = `(${isPos ? '+' : ''}${data.changePercent.toFixed(2)}%)`;
				}

				if (valPrevClose) {
					valPrevClose.textContent = Number(data.previousClose).toLocaleString('en-US', { minimumFractionDigits: 2 });
				}
				if (valDayRange) {
					valDayRange.textContent = `${Number(data.dayLow).toLocaleString('en-US', { minimumFractionDigits: 2 })} - ${Number(data.dayHigh).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
				}
				if (val52wRange) {
					val52wRange.textContent = `${Number(data.fiftyTwoWeekLow).toLocaleString('en-US', { minimumFractionDigits: 2 })} - ${Number(data.fiftyTwoWeekHigh).toLocaleString('en-US', { minimumFractionDigits: 2 })}`;
				}
				if (valMarketTime) {
					valMarketTime.textContent = data.formattedTime;
				}
				if (lastUpdatedTime) {
					lastUpdatedTime.textContent = new Date().toLocaleTimeString();
				}
				if (statusText) {
					statusText.textContent = data.status === 'live' ? 'Live Feed' : 'Cached Data';
				}

				// Merge server history with our local points
				if (data.history && data.history.length > 0) {
					const latestLocalTs = chartData.length > 0 ? chartData[chartData.length - 1].timestamp : 0;
					const newPoints = data.history.filter((pt) => pt.timestamp > latestLocalTs);

					if (newPoints.length > 0) {
						chartData.push(...newPoints);
						logTick(data.price, newPoints[newPoints.length - 1].time, 'Live Feed');
					} else if (chartData.length === 0) {
						chartData = data.history;
					} else {
						// Update the last point with latest price
						chartData[chartData.length - 1].price = data.price;
					}
				} else {
					// Append single latest point
					const now = Date.now();
					const timeStr = new Date(now).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
					chartData.push({ timestamp: now, time: timeStr, price: data.price });
					logTick(data.price, timeStr, 'Live Feed');
				}

				renderChart();
			}

			// Fetch live stock quote from API
			async function updateStock() {
				if (!refreshBtn) return;
				refreshBtn.classList.add('loading');
				refreshBtn.setAttribute('disabled', 'true');

				try {
					const res = await fetch('/api/quote.json');
					if (!res.ok) throw new Error(`HTTP ${res.status}`);
					const data: StockData = await res.json();
					updateDOMWithData(data);
				} catch (err) {
					console.error('Failed to refresh quote:', err);
					if (lastUpdatedTime) {
						lastUpdatedTime.textContent = 'Fetch failed (retrying)';
					}
				} finally {
					refreshBtn.classList.remove('loading');
					refreshBtn.removeAttribute('disabled');
				}
			}

			// Interactive Crosshair & Tooltip
			if (chartContainer && chartSvg) {
				chartContainer.addEventListener('mousemove', (e) => {
					if (calculatedPoints.length < 2) return;

					const rect = chartContainer.getBoundingClientRect();
					const mouseX = e.clientX - rect.left;
					const ratioX = mouseX / rect.width;
					const targetSvgX = ratioX * 600;

					// Find nearest point
					let nearest = calculatedPoints[0];
					let minDiff = Math.abs(calculatedPoints[0].x - targetSvgX);

					for (let i = 1; i < calculatedPoints.length; i++) {
						const diff = Math.abs(calculatedPoints[i].x - targetSvgX);
						if (diff < minDiff) {
							minDiff = diff;
							nearest = calculatedPoints[i];
						}
					}

					if (crosshairX) {
						crosshairX.setAttribute('x1', nearest.x.toFixed(1));
						crosshairX.setAttribute('x2', nearest.x.toFixed(1));
						crosshairX.setAttribute('visibility', 'visible');
					}

					if (crosshairDot) {
						crosshairDot.setAttribute('cx', nearest.x.toFixed(1));
						crosshairDot.setAttribute('cy', nearest.y.toFixed(1));
						crosshairDot.setAttribute('visibility', 'visible');
					}

					if (tooltip && tooltipPrice && tooltipTime) {
						tooltipPrice.textContent = `$${nearest.data.price.toFixed(2)}`;
						tooltipTime.textContent = nearest.data.time;
						tooltip.style.display = 'block';

						const tooltipW = 110;
						let posX = (nearest.x / 600) * rect.width - tooltipW / 2;
						posX = Math.max(8, Math.min(rect.width - tooltipW - 8, posX));
						const posY = Math.max(10, (nearest.y / 220) * rect.height - 52);

						tooltip.style.left = `${posX}px`;
						tooltip.style.top = `${posY}px`;
					}
				});

				chartContainer.addEventListener('mouseleave', () => {
					if (crosshairX) crosshairX.setAttribute('visibility', 'hidden');
					if (crosshairDot) crosshairDot.setAttribute('visibility', 'hidden');
					if (tooltip) tooltip.style.display = 'none';
				});
			}

			// Live Simulation Mode: injects dynamic incoming market micro-ticks
			function toggleSimulateTicks() {
				simulateTicks = !simulateTicks;

				if (simulateTicks) {
					if (simBtnText) simBtnText.textContent = 'Simulate Ticks: ON';
					simToggleBtn?.classList.add('active');

					simIntervalId = setInterval(() => {
						const delta = Number(((Math.random() - 0.48) * 1.8).toFixed(2));
						currentPrice = Number((currentPrice + delta).toFixed(2));
						const now = Date.now();
						const timeStr = new Date(now).toLocaleTimeString('en-US', {
							hour: 'numeric',
							minute: '2-digit',
							second: '2-digit'
						});

						// Append live tick to chart
						chartData.push({
							timestamp: now,
							time: timeStr,
							price: currentPrice
						});

						// Limit chart memory to last 60 points for performance
						if (chartData.length > 60) chartData.shift();

						// Recalculate change against previous close
						const change = Number((currentPrice - previousClose).toFixed(2));
						const changePercent = Number(((change / previousClose) * 100).toFixed(2));

						if (priceValue) {
							priceValue.textContent = currentPrice.toLocaleString('en-US', {
								minimumFractionDigits: 2,
								maximumFractionDigits: 2
							});
							priceValue.classList.remove('pulse');
							void priceValue.offsetWidth;
							priceValue.classList.add('pulse');
						}

						const isPos = change >= 0;
						if (changeBadge) {
							changeBadge.className = `change-badge ${isPos ? 'positive' : 'negative'}`;
						}
						if (changeIcon) changeIcon.textContent = isPos ? '▲' : '▼';
						if (changeAmount) {
							changeAmount.textContent = `${isPos ? '+' : ''}${change.toFixed(2)}`;
						}
						if (changePercent) {
							changePercent.textContent = `(${isPos ? '+' : ''}${changePercent.toFixed(2)}%)`;
						}

						logTick(currentPrice, timeStr, 'Simulated Tick');
						renderChart();
					}, 2400);
				} else {
					if (simBtnText) simBtnText.textContent = 'Simulate Ticks: OFF';
					simToggleBtn?.classList.remove('active');
					if (simIntervalId) {
						clearInterval(simIntervalId);
						simIntervalId = null;
					}
				}
			}

			simToggleBtn?.addEventListener('click', toggleSimulateTicks);
			refreshBtn?.addEventListener('click', updateStock);

			// Initial chart draw
			renderChart();
			logTick(currentPrice, new Date().toLocaleTimeString(), 'Initial Load');

			// Automatic live poll from Yahoo Finance API every 6 seconds
			setInterval(updateStock, 6000);
		</script>
	</body>
</html>

